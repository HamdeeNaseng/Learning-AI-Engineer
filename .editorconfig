root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces as a hard line break, so trimming them
# silently changes rendered output.
[*.md]
trim_trailing_whitespace = false

# Notebooks are generated JSON: leave formatting to Jupyter.
[*.ipynb]
insert_final_newline = false
trim_trailing_whitespace = false

# PowerShell keeps CRLF (see .gitattributes).
[*.ps1]
end_of_line = crlf