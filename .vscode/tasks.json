{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup environment",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/setup.ps1",
      "problemMatcher": []
    },
    {
      "label": "Run quality checks",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/check.ps1",
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "uv run pytest",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
