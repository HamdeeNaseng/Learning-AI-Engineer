# P1: Keep line endings consistent in the repository regardless of contributor OS.
# Everything is stored as LF; checkout follows the platform default.
* text=auto

# PowerShell scripts stay CRLF in the working tree.
*.ps1 text eol=crlf

# Shell scripts must stay LF or they fail to run.
*.sh text eol=lf

# Binary assets: never diff or convert these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.safetensors binary
*.pt binary
*.pth binary
*.ckpt binary

# Generated files: collapse in diffs and exclude from language stats.
uv.lock linguist-generated=true
skills-lock.json linguist-generated=true

# Notebooks are the main content here, so let them count toward language stats.
*.ipynb linguist-detectable=true
*.ipynb linguist-language=Jupyter Notebook
